# ==========================================
# DocuMind-RAG Environment Configuration
# Author: D Rohith Subrahmanya Sai
# GitHub: https://github.com/DRohithSubrahmanyaSai/DocuMind-RAG
# ==========================================

# Groq Cloud API Key (Get free key from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq LLM Model (Options: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768, gemma2-9b-it)
GROQ_MODEL=llama-3.3-70b-versatile

# HuggingFace Embeddings Model (Local, high speed & accuracy, free)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
BACKEND_API_URL=http://localhost:8000

# RAG & Chunking Settings
CHUNK_SIZE=600
CHUNK_OVERLAP=80
DEFAULT_TOP_K=4
RRF_K=60

# Data Storage
FAISS_INDEX_PATH=./data/faiss_index
