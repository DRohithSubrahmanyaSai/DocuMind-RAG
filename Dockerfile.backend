# ==========================================
# DocuMind-RAG FastAPI Backend Dockerfile
# Author: D Rohith Subrahmanya Sai
# ==========================================

FROM python:3.11-slim

WORKDIR /app

# Install system utilities and C++ build tools required for native modules
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements and install python packages
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code, configuration, and app files
COPY backend/ ./backend/
COPY .env.example .env* ./

# Create data directory for FAISS vector index persistence
RUN mkdir -p /app/data/faiss_index /app/data/uploads

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
